	apply_rules -.-> draft_letter;
	apply_rules -.-> review_gate;
	check_letter -.-> draft_letter;
	check_letter -.-> review_gate;
	draft_letter --> check_letter;
	extract_facts -.-> finalize;
	extract_facts -.-> plan;
	plan -.-> run_tools;
	plan -.-> verify_evidence;
	review_gate --> finalize;
	run_tools --> plan;
	screen_input -.-> extract_facts;
	screen_input -.-> finalize;
	validate_input -.-> finalize;
	validate_input -.-> screen_input;
	verify_evidence --> apply_rules;
	finalize --> __end__;
