# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=sk-ant-...

# anthropic | fake (fake = offline deterministic stand-in, no key needed)
CLAIM_AGENT_LLM_PROVIDER=anthropic
CLAIM_AGENT_MAIN_MODEL=claude-sonnet-5-5
CLAIM_AGENT_GUARD_MODEL=claude-haiku-5-5

# Guardrails
CLAIM_AGENT_MAX_PLAN_STEPS=6
CLAIM_AGENT_MAX_VALIDATION_RETRIES=2
CLAIM_AGENT_MAX_RUN_TOKENS=60000

# Optional: require an X-API-Key header on /claims endpoints
# CLAIM_AGENT_API_KEY=change-me
